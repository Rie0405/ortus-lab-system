# Hostinger setup (pick ONE location):
#
# Easiest in File Manager:
#   public_html/adminStaff/runtime/.env
#
# Best (survives Git deploy cleanly):
#   one level ABOVE public_html → .env
#   e.g. /home/uXXXX/domains/yourdomain.com/.env
#
# In File Manager: enable "Show hidden files" or the .env file won't appear.
# Never commit a real .env.

MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=u462030735_ortus
MYSQLUSER=u462030735_ortus
MYSQLPASSWORD=your_hostinger_db_password
